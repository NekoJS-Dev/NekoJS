{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "LGPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.tkisor.nekojs.fabric.NekoJSFabricMod"
    ],
    "client": [
      "com.tkisor.nekojs.fabric.NekoJSFabricClient"
    ]
  },
  "mixins": [
    "nekojs-fabric.mixins.json",
    "nekojs-fabric-shared.mixins.json",
    "nekojs-fabric-dynamic.mixins.json"
  ],
  "accessWidener": "nekojs-fabric.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
