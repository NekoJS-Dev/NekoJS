{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nekojs.com/schemas/api-contract.schema.json",
  "title": "NormativeApiContract",
  "description": "NekoJS normative API contract definition",
  "type": "object",
  "required": ["schemaVersion", "identity", "symbols"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "identity": {
      "$ref": "#/$defs/ContractIdentity"
    },
    "docs": {
      "type": "string"
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Symbol"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ErrorDefinition"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Module"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    }
  },
  "$defs": {
    "ContractIdentity": {
      "type": "object",
      "required": ["owner", "kind", "contractId", "version"],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "enum": ["PORTABLE", "FEATURE", "PLATFORM", "ADDON", "SPI"]
        },
        "contractId": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "SemVer 2.0 version, prerelease MUST be empty for normative contracts",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "Symbol": {
      "type": "object",
      "required": ["id", "signatures"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z-]*:[^:]+$"
        },
        "docs": {
          "type": "string"
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Signature"
          }
        }
      }
    },
    "Signature": {
      "type": "object",
      "required": ["parameters", "returnType"],
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "returnType": {
          "$ref": "#/$defs/TypeRef"
        },
        "isConstructor": {
          "type": "boolean"
        },
        "docs": {
          "type": "string"
        },
        "errorCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "Parameter": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TypeRef"
        },
        "optional": {
          "type": "boolean"
        },
        "varargs": {
          "type": "boolean"
        },
        "docs": {
          "type": "string"
        }
      }
    },
    "TypeRef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["PRIMITIVE", "SYMBOL", "ARRAY", "UNION", "CALLBACK", "VOID"]
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeRef"
          }
        },
        "callbackSignature": {
          "$ref": "#/$defs/Signature"
        }
      }
    },
    "Capability": {
      "type": "object",
      "required": ["id", "contractVersionRange"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "contractVersionRange": {
          "type": "string",
          "pattern": "^(exact:|\\[)[^ ]+$"
        },
        "docs": {
          "type": "string"
        }
      }
    },
    "ErrorDefinition": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["symbolId", "requiredCapability", "platform", "minecraftVersion", "replacement", "path", "operation", "limit"]
          }
        },
        "docs": {
          "type": "string"
        }
      }
    },
    "Module": {
      "type": "object",
      "required": ["id", "tier"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Module ID: @nekojs/* for core, @owner/* for addon",
          "pattern": "^@[a-z][a-z0-9_.-]*/[a-z][a-z0-9_./-]*$"
        },
        "tier": {
          "type": "string",
          "enum": ["FEATURE", "PLATFORM", "ADDON", "VERSION", "UNSAFE_NATIVE"]
        },
        "contractVersion": {
          "type": "string",
          "description": "SemVer 2.0, prerelease MUST be empty for normative contract version",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "moduleRevision": {
          "type": "integer",
          "minimum": 1
        },
        "docs": {
          "type": "string"
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Symbol"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleDependency"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "tier": {
              "const": "FEATURE"
            }
          },
          "required": ["contractVersion"]
        },
        {
          "properties": {
            "tier": {
              "const": "PLATFORM"
            }
          },
          "required": ["contractVersion"]
        },
        {
          "properties": {
            "tier": {
              "const": "ADDON"
            }
          },
          "required": ["contractVersion"]
        },
        {
          "properties": {
            "tier": {
              "const": "VERSION"
            }
          },
          "required": ["moduleRevision"]
        },
        {
          "properties": {
            "tier": {
              "const": "UNSAFE_NATIVE"
            }
          },
          "required": ["moduleRevision"]
        }
      ]
    },
    "ModuleDependency": {
      "type": "object",
      "required": ["moduleId"],
      "additionalProperties": false,
      "properties": {
        "moduleId": {
          "type": "string"
        },
        "versionRange": {
          "type": "string",
          "pattern": "^(exact:|\\[)[^ ]+$"
        },
        "targetTier": {
          "type": "string",
          "enum": ["FEATURE", "PLATFORM", "ADDON", "VERSION"]
        }
      }
    },
    "Event": {
      "type": "object",
      "required": ["group", "name", "tier", "dispatch"],
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "tier": {
          "type": "string",
          "enum": ["STARTUP", "SERVER", "CLIENT"]
        },
        "dispatch": {
          "$ref": "#/$defs/EventDispatch"
        },
        "cancellable": {
          "type": "boolean",
          "description": "三态承诺：true/false 为跨平台承诺；省略表示平台间不一致、不承诺"
        },
        "payload": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventPayloadField"
          }
        },
        "docs": {
          "type": "string"
        }
      }
    },
    "EventDispatch": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["PLAIN", "BY_ID"]
        },
        "keyType": {
          "type": "string",
          "description": "BY_ID 时的键类型（当前固定为 string）"
        }
      }
    },
    "EventPayloadField": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "kind": {
          "type": "string",
          "enum": ["PORTABLE", "NATIVE"]
        },
        "portType": {
          "description": "PORTABLE 字段的可移植类型；NATIVE 字段不得携带",
          "$ref": "#/$defs/TypeRef"
        },
        "docs": {
          "type": "string"
        }
      }
    }
  }
}
