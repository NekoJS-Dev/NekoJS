{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "nekojs",
    "noEmit": true,
    "skipLibCheck": false,
    "typeRoots": ["./generated"]
  },
  "include": ["managed-api-usage.ts", "jsx-primitive-props.tsx", "jsx-advanced-controls.tsx", "jsx-workspace.tsx", "generated/**/*.d.ts"]
}
